# ── Smoke-test outputs (intermediate test run, not results) ────────────────────
patch_code/analysis/01_monot5_layer_patching/outputs_smoke/

# ── ecir24 adversarial evaluation (58 GB of runs/data – too large for GitHub) ─
ecir24-adversarial-evaluation/

# ── Slurm job logs ────────────────────────────────────────────────────────────
slurm_logs/

# ── PDF papers ────────────────────────────────────────────────────────────────
*.pdf

