__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
*.egg
.eggs/
dist/
build/

# ── Jupyter ────────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ── Activation tensors (large, ~1.8 GB) ────────────────────────────────────────
patch_code/analysis/01_monot5_layer_patching/outputs/activations/*
